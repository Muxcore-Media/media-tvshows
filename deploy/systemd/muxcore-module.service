[Unit]
Description=MuxCore Module - media-tvshows
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/media-tvshows \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id media-tvshows
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/media-tvshows

[Install]
WantedBy=multi-user.target
